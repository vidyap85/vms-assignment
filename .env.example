# Copy this file to .env and adjust as needed. docker-compose reads this automatically.

POSTGRES_DB=vms
POSTGRES_USER=vms
POSTGRES_PASSWORD=vms_password

# Change these before any real deployment.
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me

# Public origin the browser will use to reach the app (nginx entrypoint).
WEB_ORIGIN=http://localhost:8090
WEB_PORT=8090

# Number of simulated RTSP cameras to publish/seed.
CAMERA_COUNT=9

# Continuous-recording segment length and keyframe thumbnail interval, in seconds.
RECORDING_SEGMENT_SECONDS=60
KEYFRAME_INTERVAL_SECONDS=30

# Used only to compute the storage usage % shown on the dashboard (default 20GiB).
STORAGE_CAPACITY_BYTES=21474836480
