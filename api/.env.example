# For running the API locally with `npm run dev` (outside Docker).
# Point DATABASE_URL at a local Postgres, and MEDIAMTX_* at wherever you're running mediamtx.

PORT=4000
DATABASE_URL=postgresql://vms:vms_password@localhost:5432/vms
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
WEB_ORIGIN=http://localhost:5173
CAMERA_COUNT=9
MEDIAMTX_RTSP_BASE=rtsp://localhost:8554
MEDIA_ROOT=./media
RECORDING_SEGMENT_SECONDS=60
KEYFRAME_INTERVAL_SECONDS=30
